---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<article>
		<header class="post-header">
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="updated">
							{' · updated '}
							<FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			{
				tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
		</header>

		<div class="prose">
			<slot />
		</div>
	</article>

	<p class="back"><a href="/">&larr; All posts</a></p>
</BaseLayout>

<style>
	.post-header {
		margin-bottom: 1.5rem;
	}

	/* Headings inherit the global type scale (h1 = 2.5rem, weight 400); only
	   the top margin needs cancelling since this one starts the page. */
	.post-header h1 {
		margin-top: 0;
		margin-bottom: 0.75rem;
	}

	.meta {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
	}

	.tags li {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.25rem;
		padding: 0.1rem 0.4rem;
	}

	/* The theme's global scale (h2 = 2rem, weight 400) suits short doc pages.
	   In a long post the sections need to read as breaks, so h2 gets a rule
	   above it and h3 sits clearly below it in the hierarchy. */
	.prose :global(h2) {
		font-size: 1.6rem;
		font-weight: 600;
		margin-top: 3.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.prose :global(h3) {
		font-size: 1.2rem;
		font-weight: 600;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-block: 0 1rem;
	}

	/* Figures. The plots have a light background, so in dark mode they get a
	   white card rather than glaring straight out of the page. */
	.prose :global(img) {
		display: block;
		width: 100%;
		margin-block: 1.5rem 0.5rem;
		background: #ffffff;
		border: 1px solid var(--border);
		border-radius: 0.25rem;
		padding: 0.5rem;
	}

	/* The italic line right after an image is its caption. */
	.prose :global(p > em:only-child) {
		display: block;
		color: var(--muted);
		font-size: 0.875rem;
		font-style: normal;
	}

	.prose :global(li) {
		margin-bottom: 0.3rem;
	}

	.back {
		margin-top: 3.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
</style>
