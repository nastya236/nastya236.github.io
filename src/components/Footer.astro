---
import { AUTHOR, SOCIALS } from '../consts';

// Build-time constant; safe because the site is statically generated.
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<span>&copy; {year} {AUTHOR}</span>
		<span class="links">
			{SOCIALS.map((s) => <a href={s.href} rel="me">{s.label}</a>)}
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.875rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding-block: 1.5rem;
	}

	.links {
		display: flex;
		gap: 1rem;
	}
</style>
